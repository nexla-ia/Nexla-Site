{
  "rewrites": [
    {
      "source": "/academy/curso/:slug",
      "has": [{ "type": "header", "key": "user-agent", "value": ".*(WhatsApp|facebookexternalhit|Facebot|LinkedInBot|Twitterbot|TelegramBot|Slackbot|Discordbot|SkypeUriPreview).*" }],
      "destination": "/api/previa?curso=:slug"
    },
    {
      "source": "/academy/validar/:codigo",
      "has": [{ "type": "header", "key": "user-agent", "value": ".*(WhatsApp|facebookexternalhit|Facebot|LinkedInBot|Twitterbot|TelegramBot|Slackbot|Discordbot|SkypeUriPreview).*" }],
      "destination": "/api/previa?certificado=:codigo"
    },
    { "source": "/academy", "destination": "/academy/index.html" },
    { "source": "/academy/:path*", "destination": "/academy/index.html" },
    { "source": "/tasabendo", "destination": "/tasabendo/index.html" }
  ],
  "headers": [
    {
      "source": "/academy(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'none'" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
